# Node Environment
NODE_ENV=development
PORT=3001

# Allowed Origins (Comma-separated for CORS and WebSocket)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Limits
PAIRING_TTL_SECONDS=120
TRANSFER_TTL_MINUTES=15
SESSION_IDLE_MINUTES=30
MAX_TRANSFERS_PER_SESSION=20
MAX_TRANSFER_BYTES=102656
MAX_BODY_SIZE=200kb

# Rate Limiting
RATE_LIMIT_PAIRING_WINDOW_MS=60000
RATE_LIMIT_PAIRING_MAX=5
RATE_LIMIT_TRANSFER_WINDOW_MS=60000
RATE_LIMIT_TRANSFER_MAX=60
